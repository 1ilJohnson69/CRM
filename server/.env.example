DATABASE_URL=postgres://forge:forge@localhost:5432/forge_crm
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Messaging gateways (optional). Leave a channel unset and its messages wait in
# the CRM's manual send queue. Each URL receives POST {channel,to,subject,body,reference}.
MESSAGING_WHATSAPP_URL=
MESSAGING_WHATSAPP_TOKEN=
MESSAGING_WHATSAPP_PROVIDER=
MESSAGING_SMS_URL=
MESSAGING_SMS_TOKEN=
MESSAGING_SMS_PROVIDER=
MESSAGING_EMAIL_URL=
MESSAGING_EMAIL_TOKEN=
MESSAGING_EMAIL_PROVIDER=
